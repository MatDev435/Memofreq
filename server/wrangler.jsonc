// Configuração pública do backend multiplayer. Credenciais nunca ficam aqui:
// use `wrangler login` ou variáveis em server/.env (veja server/.env.example).
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "memofreq-multiplayer",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RoomObject" }],
  },
  // O plano gratuito aceita somente Durable Objects com storage SQLite.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomObject"] }],
  "vars": {
    // Origens públicas, não secretas. Inclua aqui novos domínios do frontend.
    "ALLOWED_ORIGINS": "https://memofreq.vercel.app,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173",
  },
}
