# Variáveis do Wrangler para publicar o backend multiplayer.
#
# Copie este arquivo para server/.env SOMENTE se for publicar sem `wrangler login`
# (por exemplo, em automações). O arquivo server/.env é ignorado pelo Git e
# nunca deve ser enviado ao repositório. Não coloque valores reais aqui.
#
# Os scripts `npm run server:dev` e `npm run server:deploy` executam o Wrangler
# com `--cwd server`, que carrega server/.env automaticamente.

# Token de API da Cloudflare criado com o modelo "Edit Cloudflare Workers".
CLOUDFLARE_API_TOKEN=

# ID da conta Cloudflare (painel da Cloudflare → Workers & Pages → Account ID).
CLOUDFLARE_ACCOUNT_ID=
