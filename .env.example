# Variáveis do frontend (Vite). Copie para .env.local, que é ignorado pelo Git.
# Tudo com prefixo VITE_ é embutido no JavaScript enviado ao navegador:
# nunca coloque tokens, senhas ou outros segredos aqui.

# URL WebSocket do backend multiplayer.
# Local, com `npm run server:dev`: ws://127.0.0.1:8787
# Produção (painel da Vercel): wss://memofreq-multiplayer.<subdominio>.workers.dev
# Sem esta variável, o multiplayer aparece como indisponível.
VITE_MULTIPLAYER_URL=ws://127.0.0.1:8787
